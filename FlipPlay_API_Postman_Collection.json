{
	"info": {
		"_postman_id": "flipplay-rest-api-modul4",
		"name": "FlipPlay REST API - Modul 4",
		"description": "Koleksi Postman lengkap untuk pengujian REST API FlipPlay Modul 4. Mencakup skenario Berhasil (Happy Path) dan skenario Gagal (Validation 422 & Duplicate Conflict 409).",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://127.0.0.1:8000/api",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "1. Media (CRUD & Filter)",
			"item": [
				{
					"name": "GET List Semua Media (Happy Path - 200 OK)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/media",
							"host": ["{{base_url}}"],
							"path": ["media"]
						},
						"description": "Menampilkan seluruh daftar media yang tersedia di FlipPlay (HTTP 200 OK)."
					}
				},
				{
					"name": "GET Cari Media berdasarkan Judul (Filter Index - 200 OK)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/media?search=Inception",
							"host": ["{{base_url}}"],
							"path": ["media"],
							"query": [
								{
									"key": "search",
									"value": "Inception"
								}
							]
						},
						"description": "Mencari media berdasarkan kata kunci judul/genre/deskripsi melalui query filter endpoint index."
					}
				},
				{
					"name": "GET Detail Satu Media & Pengguna (whenLoaded - 200 OK)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/media/1",
							"host": ["{{base_url}}"],
							"path": ["media", "1"]
						},
						"description": "Menampilkan detail satu media beserta daftar pengguna yang memasukkannya ke koleksi (eager loading relasi users)."
					}
				},
				{
					"name": "POST Tambah Media Baru (Happy Path - 201 Created)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Interstellar\",\n    \"type\": \"movie\",\n    \"genre\": \"Sci-Fi / Adventure\",\n    \"release_year\": 2014,\n    \"duration\": 169,\n    \"description\": \"Petualangan melintasi lubang cacing untuk mencari planet baru bagi peradaban manusia.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/media",
							"host": ["{{base_url}}"],
							"path": ["media"]
						},
						"description": "Menambahkan media baru ke dalam katalog sistem (HTTP 201 Created)."
					}
				},
				{
					"name": "POST Tambah Media - Gagal (Judul Kosong - 422 Unprocessable)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"\",\n    \"type\": \"movie\",\n    \"genre\": \"Action\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/media",
							"host": ["{{base_url}}"],
							"path": ["media"]
						},
						"description": "Skenario Gagal: Form Request Validation menolak request jika judul kosong (HTTP 422 Unprocessable Entity)."
					}
				},
				{
					"name": "POST Tambah Media - Gagal (Judul Duplikat - 422 Unprocessable)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Inception\",\n    \"type\": \"movie\",\n    \"genre\": \"Sci-Fi\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/media",
							"host": ["{{base_url}}"],
							"path": ["media"]
						},
						"description": "Skenario Gagal: Form Request menolak judul 'Inception' karena sudah terdaftar di database (HTTP 422 Unprocessable Entity)."
					}
				},
				{
					"name": "PUT Update Data Media (Happy Path - 200 OK)",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"title\": \"Inception (Special 4K Edition)\",\n    \"type\": \"movie\",\n    \"genre\": \"Sci-Fi / Thriller\",\n    \"release_year\": 2010,\n    \"duration\": 155,\n    \"description\": \"Versi remaster dengan tambahan adegan behind the scenes.\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/media/1",
							"host": ["{{base_url}}"],
							"path": ["media", "1"]
						},
						"description": "Memperbarui data media (HTTP 200 OK)."
					}
				},
				{
					"name": "DELETE Hapus Media (Happy Path - 200 OK)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/media/4",
							"host": ["{{base_url}}"],
							"path": ["media", "4"]
						},
						"description": "Menghapus media dari katalog berdasarkan ID (HTTP 200 OK)."
					}
				}
			]
		},
		{
			"name": "2. Koleksi Pengguna (Custom Action Relasi)",
			"item": [
				{
					"name": "GET Tampilkan Koleksi Media Pengguna (200 OK)",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/1/collections",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "collections"]
						},
						"description": "Menampilkan seluruh koleksi media milik pengguna ID 1 beserta catatan pivot-nya (HTTP 200 OK)."
					}
				},
				{
					"name": "POST Tambah Media ke Koleksi (Happy Path - 201 Created)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"media_id\": 3,\n    \"notes\": \"Disimpan untuk ditonton akhir pekan\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/1/collections",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "collections"]
						},
						"description": "Custom action: menambahkan media ke koleksi pengguna menggunakan attach() (HTTP 201 Created)."
					}
				},
				{
					"name": "POST Tambah Media ke Koleksi - Gagal Duplikat (409 Conflict)",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							},
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"media_id\": 1,\n    \"notes\": \"Coba masukkan lagi yang sudah ada\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/users/1/collections",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "collections"]
						},
						"description": "Skenario Gagal: Menolak menambahkan media ID 1 yang sudah ada di koleksi pengguna (HTTP 409 Conflict sesuai Modul 4 hal 26)."
					}
				},
				{
					"name": "DELETE Hapus Media dari Koleksi (Happy Path - 200 OK)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/1/collections/2",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "collections", "2"]
						},
						"description": "Custom action: menghapus media ID 2 dari koleksi pengguna ID 1 menggunakan detach() (HTTP 200 OK)."
					}
				},
				{
					"name": "DELETE Hapus Media dari Koleksi - Gagal (404 Not Found)",
					"request": {
						"method": "DELETE",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{base_url}}/users/1/collections/99",
							"host": ["{{base_url}}"],
							"path": ["users", "1", "collections", "99"]
						},
						"description": "Skenario Gagal: Menolak hapus jika media ID 99 tidak ada di koleksi pengguna (HTTP 404 Not Found)."
					}
				}
			]
		},
